    "fast-xml-parser": "^5.11.2",
    "lucide-react": "latest",
    "next": "16.4.2",
    "radix-ui": "latest",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
