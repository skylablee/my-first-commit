# 공개 가능: 프로젝트 URL, anon/publishable key만 입력하세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 이전 PHASE 1 이름도 호환됩니다. 위 ANON_KEY 설정을 권장합니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용: 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 단계별로 별도 Supabase/Meta/결제 계정을 사용하세요.
APP_ENV=development
APP_URL=http://localhost:3000
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/api/threads/callback
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_CLIENT_KEY=
PAYMENT_WEBHOOK_SECRET=
# Stripe 월간 KRW Price IDs. Toss 어댑터는 아직 활성화하지 않습니다.
PAYMENT_PRICE_STARTER=
PAYMENT_PRICE_PRO=
PAYMENT_PRICE_AGENCY=
# 32자 이상의 별도 난수
CRON_SECRET=

# development/test에서만 관리자 staging 도구를 켭니다. staging 환경은 자동 활성화됩니다.
# DB operating_settings.staging_validation_enabled=true도 별도로 필요합니다.
STAGING_VALIDATION_ENABLED=false
